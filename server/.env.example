# Copy to .env and fill in. Never commit the real file.

# The only place your Anthropic key exists.
ANTHROPIC_API_KEY=sk-ant-...

# Signs device tokens. Generate with: openssl rand -base64 48
AUTH_SECRET=change-me-to-at-least-32-random-characters

PORT=8787
DATABASE_PATH=./data/app.db

# Credits given once per new install. 40 buys 3 quick checks, 3 advanced ones
# and a single full report - about 41 cents of upstream cost per signup that
# never pays, which is the price of letting someone taste the best tier.
FREE_TRIAL_CREDITS=40

# The free plan: what a user without a subscription is topped back up to each
# week. A top-up, not an addition, so it cannot be hoarded into a free report.
# Set to 0 to switch the free plan off.
FREE_WEEKLY_CREDITS=5

# Shared secret the stores must send as x-webhook-secret on their notification
# endpoints. Required once PURCHASE_VERIFICATION=live, or renewals are only
# noticed when the app next opens. Generate with: openssl rand -base64 32
# WEBHOOK_SECRET=

# Submission ceilings, enforced before any tokens are bought.
MAX_WORDS_STANDARD=600
MAX_WORDS_DEEP=1500
MAX_ATTACHMENT_MB=6

# Per-device abuse limits.
RATE_LIMIT_PER_MINUTE=4
RATE_LIMIT_PER_DAY=60

# Only needed for the Flutter web build.
ALLOWED_ORIGINS=

# mock accepts any receipt - for local development only.
PURCHASE_VERIFICATION=mock

# mock accepts `mock:<subject>:<email>` as a sign-in token - local only.
AUTH_VERIFICATION=mock

# --- Sign-in (AUTH_VERIFICATION=live) ---
# Every client id that may appear as the token audience, comma separated.
# GOOGLE_OAUTH_CLIENT_IDS=1234-android.apps.googleusercontent.com,1234-ios.apps.googleusercontent.com
# APPLE_CLIENT_IDS=com.writingchecker.writingChecker

# --- Google Play (PURCHASE_VERIFICATION=live) ---
# GOOGLE_PACKAGE_NAME=com.writingchecker.writing_checker
# GOOGLE_SERVICE_ACCOUNT_EMAIL=play-billing@your-project.iam.gserviceaccount.com
# GOOGLE_SERVICE_ACCOUNT_KEY="-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n"

# --- App Store (PURCHASE_VERIFICATION=live) ---
# APPLE_BUNDLE_ID=com.writingchecker.writingChecker
# APPLE_ISSUER_ID=57246542-96fe-1a63-e053-0824d011072a
# APPLE_KEY_ID=2X9R4HXF34
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIG...\n-----END PRIVATE KEY-----\n"
# APPLE_ENVIRONMENT=sandbox
